            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"BedrockModelAccess\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"bedrock:StartIngestionJob\",\n        \"bedrock:RetrieveAndGenerate\",\n        \"bedrock:Retrieve\",\n        \"bedrock:ListIngestionJobs\",\n        \"bedrock:ListDataSources\",\n        \"bedrock:InvokeModel\",\n        \"bedrock:GetIngestionJob\",\n        \"bedrock:ConverseStream\",\n        \"bedrock:Converse\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"S3DocumentStorageAccess\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:PutObject\",\n        \"s3:ListBucket\",\n        \"s3:GetObject\",\n        \"s3:DeleteObject\"\n      ],\n      \"Resource\": [\n        \"arn:aws:s3:::studybot-docs-5ssgi7/*\",\n        \"arn:aws:s3:::studybot-docs-5ssgi7\"\n      ]\n    },\n    {\n      \"Sid\": \"DynamoDBUserStoreAccess\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"dynamodb:UpdateItem\",\n        \"dynamodb:Scan\",\n        \"dynamodb:Query\",\n        \"dynamodb:PutItem\",\n        \"dynamodb:GetItem\",\n        \"dynamodb:DeleteItem\"\n      ],\n      \"Resource\": [\n        \"arn:aws:dynamodb:us-east-1:688331456747:table/studybot-users/*\",\n        \"arn:aws:dynamodb:us-east-1:688331456747:table/studybot-users\"\n      ]\n    }\n  ]\n}",
